<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Shared strictness settings live in Directory.Build.props — test code is held to the same gate. -->
    <Description>ClipForge automated tests: the seams that run off-Windows (Core, Secrets, Search, Storage.Sqlite). The WPF app is covered by manual verification — it cannot execute off-Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClipForge.Core\ClipForge.Core.csproj" />
    <ProjectReference Include="..\..\src\ClipForge.Secrets\ClipForge.Secrets.csproj" />
    <ProjectReference Include="..\..\src\ClipForge.Search\ClipForge.Search.csproj" />
    <ProjectReference Include="..\..\src\ClipForge.Storage.Sqlite\ClipForge.Storage.Sqlite.csproj" />
  </ItemGroup>

</Project>
