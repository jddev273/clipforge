<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Shared strictness settings live in Directory.Build.props (bug-class-eliminator Phase 0). -->
    <UseWPF>true</UseWPF>
    <!-- Compile-only on non-Windows dev machines (Linux CI/VM): no WPF runtime needed to build. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>ClipForge</AssemblyName>
    <Description>ClipForge — the clipboard manager rebuilt for 2026. Free, fast, beautiful.</Description>
    <PublishDir>publish\</PublishDir>
    <!-- Branded icon: exe icon + WPF resource (tray + overlay window). -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- Publish defaults: framework-dependent + ReadyToRun via the Fast publish profile
         (Properties/PublishProfiles/Fast.pubxml). The box has the .NET 8 desktop runtime,
         so self-contained single-file is pure dead weight (was 163MB, ~2min cold start). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipForge.Core\ClipForge.Core.csproj" />
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
