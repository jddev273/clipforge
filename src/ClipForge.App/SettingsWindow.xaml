<Window x:Class="ClipForge.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipForge Settings" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="16">
        <TextBlock Text="History" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Keep unpinned clips for (days)" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="retentionBox" Margin="0,2"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Max unpinned clips" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="maxClipsBox" Margin="0,2"/>
        </Grid>

        <TextBlock Text="Never capture from these apps (one per line)" FontWeight="SemiBold" Margin="0,12,0,8"/>
        <TextBox x:Name="excludedBox" Height="70" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 ToolTip="Matched against process names, e.g. 'slack' skips anything with slack in its process name"/>

        <TextBlock Text="Hotkey" FontWeight="SemiBold" Margin="0,12,0,8"/>
        <DockPanel>
            <TextBox x:Name="hotkeyBox" IsReadOnly="True" Width="220"
                     ToolTip="Click Change, then press the new chord"/>
            <Button Content="Change…" Click="ChangeHotkey_Click" Margin="8,0,0,0" Padding="12,4"/>
        </DockPanel>
        <TextBlock x:Name="hotkeyHint" Text="" FontSize="11" Foreground="#8A8AA5" Margin="0,4,0,0"/>

        <CheckBox x:Name="autostartCheck" Content="Start ClipForge with Windows" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
